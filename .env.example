# Turso (libSQL)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional client-side fallback (same value as R2_PUBLIC_BASE_URL). The server
# now sends each photo's resolved public URL, so cross-device thumbnails render
# even if this is left blank; set it only as a belt-and-suspenders fallback.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Voice transcription (OpenRouter, OpenAI-compatible audio API)
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_PROVIDER=openrouter
TRANSCRIPTION_MODEL=mistralai/voxtral-mini-transcribe

# Kombucha Buddy — the agentic assistant (OpenRouter, OpenAI-compatible chat API).
# Optional: leave ASSISTANT_API_KEY blank to keep the buddy disabled; the app
# still boots and /api/assistant returns 503. The model must support tool use.
# ASSISTANT_MODEL is an OpenRouter slug — change it to any tool-capable model.
ASSISTANT_API_KEY=
ASSISTANT_PROVIDER=openrouter
ASSISTANT_MODEL=anthropic/claude-sonnet-4.5

# Session signing (used to sign the session cookie). At least 16 chars.
APP_SECRET=

# Auth: magic-link email login
# Canonical origin used to build sign-in links.
APP_BASE_URL=https://myferment.com
# Comma-separated emails allowed to request a login link.
AUTH_ALLOWLIST=you@example.com

# SMTP (mxroute)
SMTP_HOST=
# 587 for STARTTLS (SMTP_SECURE=false) or 465 for implicit TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# From header, e.g. "MyFerment <login@myferment.com>"
SMTP_FROM=MyFerment <login@myferment.com>
