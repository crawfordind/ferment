# Turso (libSQL)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Same value as R2_PUBLIC_BASE_URL, exposed to the browser for rendering photo thumbnails.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Voice transcription (OpenRouter, OpenAI-compatible audio API)
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_PROVIDER=openrouter
TRANSCRIPTION_MODEL=mistralai/voxtral-mini-transcribe

# Access gate
APP_PASSCODE=
APP_SECRET=
